{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["svelte", "vite/client", "node"],
    "useDefineForClassFields": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    "verbatimModuleSyntax": true,

    "baseUrl": ".",
    "paths": {
      "$lib": ["src/lib/index.ts"],
      // Rune stores use the `.svelte.ts` extension, which TS does not probe on
      // its own; these more specific patterns must be listed to win over
      // `$lib/*`.
      "$lib/router": ["src/lib/router.svelte.ts"],
      "$lib/stores/*": ["src/lib/stores/*.svelte.ts"],
      "$lib/*": ["src/lib/*"],
      "$api/*": ["src/lib/api/*"],
      "$styles/*": ["src/lib/styles/*"],
      "$utils/*": ["src/lib/utils/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "vite.config.ts", "tailwind.config.ts"],
  "exclude": ["node_modules", "dist", "src-tauri"]
}
